# Copy to .env and replace every placeholder. Keep .env private and never commit it.
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
MONGODB_URI=mongodb://cyclekernel:[REDACTED]@mongodb:27017/cyclekernel?authSource=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_VALUE
GRAFANA_ADMIN_USER=admin
GRAFANA_ROOT_URL=http://localhost:3001
CYCLEKERNEL_PUBLISH_ADDR=127.0.0.1
CYCLEKERNEL_WEB_PORT=8080
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Required for approving agent tool execution and viewing pending approvals.
# Use a strong secret and never expose it to public browser JavaScript.
CK_TOOL_APPROVAL_TOKEN=CHANGE_ME_WITH_A_LONG_RANDOM_TOOL_APPROVAL_SECRET
# Separate secret for privileged chat agent execution, direct tools and circuit/bulkhead mutations.
CK_TOOL_EXECUTION_TOKEN=CHANGE_ME_WITH_A_DISTINCT_LONG_RANDOM_EXECUTION_SECRET
# Separate internal-only terminal service credential for chat and orchestrator.
# Do not reuse operator approval or execution credentials.
CK_TERMINAL_SERVICE_TOKEN=CHANGE_ME_WITH_A_THIRD_RANDOM_TERMINAL_SERVICE_SECRET

# ---------------------------------------------------------------------------
# Fusion Bridge / relay intake (src/bridge, docker-compose.ghost.yml)
# ---------------------------------------------------------------------------
# Copy to .env beside docker-compose.ghost.yml.
# Compose interpolates these names. .env is gitignored; do not commit a real token.

# Shared secret for POST /v1/events. Empty keeps intake closed (403).
# CK_FUSION_TOKEN is the Fusion Bridge contract name and wins over FUSION_TOKEN.
CK_FUSION_TOKEN=replace-with-a-long-random-string
# FUSION_TOKEN=
# Also accepted, including Authorization: Bearer and X-Events-Token.
CK_EVENTS_TOKEN=replace-with-a-long-random-string
# Still accepted while operators rotate the current token. Clear it after the cutover.
CK_EVENTS_TOKEN_PREVIOUS=

CK_SYNTHETIC=0
WS_RELAY_URL=ws://ws-relay:8081/ws/out
RELAY_URL=ws://ws-relay:8081/ws/out
# Fusion contract cap. Larger values are clamped to 4096.
CK_EVENTS_MAX_BYTES=4096
CK_EVENTS_MAX_RECENT=100
# Durable event log and dedup tombstones. Compose mounts a volume here.
CK_EVENTS_PATH=/var/lib/cyclekernel/events.json
CK_RELAY_QUEUE_MAX=32
