FROM python:3.12-slim AS build
WORKDIR /build
COPY src/orchestrator/requirements.txt /tmp/req-orch.txt
COPY src/agents/requirements.txt /tmp/req-agents.txt
RUN pip wheel --no-cache-dir --wheel-dir /wheels -r /tmp/req-orch.txt -r /tmp/req-agents.txt

FROM python:3.12-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/* \
    && groupadd --system app && useradd --system --gid app --home-dir /app app
COPY --from=build /wheels /wheels
COPY src/orchestrator/requirements.txt /tmp/req-orch.txt
COPY src/agents/requirements.txt /tmp/req-agents.txt
RUN pip install --no-cache-dir --no-index --find-links=/wheels -r /tmp/req-orch.txt -r /tmp/req-agents.txt && rm -rf /wheels
COPY src/orchestrator /app/orchestrator
COPY src/agents /app/agents
COPY src/bridge /app/bridge
RUN chmod -R a=rX /app/orchestrator /app/agents /app/bridge
USER app
EXPOSE 8100
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD curl -fsS http://127.0.0.1:8100/health || exit 1
CMD ["uvicorn", "orchestrator.main:app", "--host", "0.0.0.0", "--port", "8100"]
