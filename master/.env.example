# Copy to master/.env. Compose reads this directory when you run
# docker compose -f master/docker-compose.yml. .env is gitignored.

# Shared secret for POST /v1/events. Empty keeps intake closed (403).
# CK_FUSION_TOKEN is the Fusion Bridge contract name and wins over FUSION_TOKEN.
CK_FUSION_TOKEN=replace-with-a-long-random-string
# FUSION_TOKEN=
# Also accepted, including Authorization: Bearer and X-Events-Token.
CK_EVENTS_TOKEN=replace-with-a-long-random-string
# Still accepted while operators rotate the current token. Clear it after the cutover.
CK_EVENTS_TOKEN_PREVIOUS=

CK_SYNTHETIC=0
WS_RELAY_URL=ws://ws-relay:8081/ws/out
RELAY_URL=ws://ws-relay:8081/ws/out
# Fusion contract cap. Larger values are clamped to 4096.
CK_EVENTS_MAX_BYTES=4096
CK_EVENTS_MAX_RECENT=100
CK_RELAY_QUEUE_MAX=32
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
